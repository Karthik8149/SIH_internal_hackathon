/*
  SIH26058 - FINAL Arduino UNO 2-Pot Adaptive LFM Controller
  ===========================================================

  CORE PROPOSAL:
    Center frequency fc = ADAPTIVE
    LFM bandwidth B    = CONSTANT

  Current hardware:
    A0 = Temperature potentiometer
    A1 = Depth potentiometer

  Fixed until those sensors are available:
    Salinity  = 35 ppt
    Turbidity = 100 NTU

  Sensor mapping:
    0-5 V -> Temperature = -2 to 30 deg C
    0-5 V -> Depth       = 0 to 8000 m

  Current MATLAB LUT rows embedded below:
    Row 1: T=1.2 C,  D=7680 m -> C1 -> fc=50 kHz
    Row 2: T=7.6 C,  D=5600 m -> C2 -> fc=100 kHz
    Row 3: T=14.0 C, D=3040 m -> C3 -> fc=200 kHz
    Row 4: T=20.4 C, D=960 m  -> C3 -> fc=200 kHz
    Row 5: T=26.8 C, D=80 m   -> C2 -> fc=100 kHz

  IMPORTANT:
    - ONLY fc changes.
    - Bandwidth is ALWAYS 50 kHz.
    - Pulse duration is kept at the MATLAB baseline value: 300 us.
    - The Arduino currently reports the selected waveform parameters.
    - It does NOT physically generate the high-frequency LFM waveform.

  Serial Monitor:
    115200 baud
*/

#include <Arduino.h>

// ============================================================================
// 1. PINS
// ============================================================================

const uint8_t TEMP_PIN  = A0;
const uint8_t DEPTH_PIN = A1;

// ============================================================================
// 2. GLOBAL WAVEFORM PARAMETERS
// ============================================================================

// THIS NEVER CHANGES.
const float FIXED_BANDWIDTH_KHZ = 50.0f;

// MATLAB baseline pulse duration from the original simulation.
const float FIXED_PULSE_US = 300.0f;

// ============================================================================
// 3. SENSOR / ADC PARAMETERS
// ============================================================================

const float VREF = 5.0f;
const int ADC_MAX_VALUE = 1023;
const uint8_t NUM_SAMPLES = 8;

const float TEMP_MIN_C = -2.0f;
const float TEMP_MAX_C = 30.0f;

const float DEPTH_MIN_M = 0.0f;
const float DEPTH_MAX_M = 8000.0f;

// Not available yet: held fixed for this 2-pot prototype.
const float FIXED_SALINITY_PPT = 35.0f;
const float FIXED_TURBIDITY_NTU = 100.0f;

// ============================================================================
// 4. LUT STRUCTURE
// ============================================================================

struct LUTEntry
{
  float temperature_C;
  float depth_m;

  const char *mode;
  float centerFrequency_kHz;
};

// ============================================================================
// 5. CURRENT MATLAB LUT
//
// IMPORTANT:
// The bandwidth is NOT stored in the LUT because bandwidth is fixed.
//
// The LUT ONLY selects center frequency.
// ============================================================================

const LUTEntry LUT[] =
{
  { 1.2f, 7680.0f, "C1",  50.0f },
  { 7.6f, 5600.0f, "C2", 100.0f },
  {14.0f, 3040.0f, "C3", 200.0f },
  {20.4f,  960.0f, "C3", 200.0f },
  {26.8f,   80.0f, "C2", 100.0f }
};

const uint8_t LUT_SIZE =
    sizeof(LUT) / sizeof(LUT[0]);

// ============================================================================
// 6. PREVIOUS SELECTION
// ============================================================================

int previousLUTIndex = -1;
float previousFc_kHz = -1.0f;

// ============================================================================
// 7. READ ADC VOLTAGE
// ============================================================================

float readVoltage(uint8_t pin)
{
  long total = 0;

  for (uint8_t i = 0; i < NUM_SAMPLES; i++)
  {
    total += analogRead(pin);
    delay(2);
  }

  float adcAverage =
      (float)total / (float)NUM_SAMPLES;

  return adcAverage * VREF / (float)ADC_MAX_VALUE;
}

// ============================================================================
// 8. MAP 0-5 V TO PHYSICAL RANGE
// ============================================================================

float mapVoltage(
    float voltage,
    float physicalMin,
    float physicalMax)
{
  voltage = constrain(voltage, 0.0f, 5.0f);

  return physicalMin +
         (voltage / 5.0f) *
         (physicalMax - physicalMin);
}

// ============================================================================
// 9. MACKENZIE SOUND SPEED
// ============================================================================

float MackenzieSoundSpeed(
    float T,
    float S,
    float D)
{
  return
      1448.96f
      + 4.591f * T
      - 5.304e-2f * T * T
      + 2.374e-4f * T * T * T
      + 1.340f * (S - 35.0f)
      + 1.630e-2f * D
      + 1.675e-7f * D * D
      - 1.025e-2f * T * (S - 35.0f)
      - 7.139e-13f * T * D * D * D;
}

// ============================================================================
// 10. NORMALIZED DISTANCE
//
// Only T and Depth are varying in this 2-pot demonstration.
// ============================================================================

float lutDistance(
    float temperature,
    float depth,
    const LUTEntry &entry)
{
  float dT =
      (temperature - entry.temperature_C) /
      (TEMP_MAX_C - TEMP_MIN_C);

  float dD =
      (depth - entry.depth_m) /
      (DEPTH_MAX_M - DEPTH_MIN_M);

  return dT * dT + dD * dD;
}

// ============================================================================
// 11. FIND NEAREST LUT POINT
// ============================================================================

int findNearestLUT(
    float temperature,
    float depth,
    float &bestDistance)
{
  int bestIndex = 0;

  bestDistance =
      lutDistance(
          temperature,
          depth,
          LUT[0]);

  for (uint8_t i = 1; i < LUT_SIZE; i++)
  {
    float distance =
        lutDistance(
            temperature,
            depth,
            LUT[i]);

    if (distance < bestDistance)
    {
      bestDistance = distance;
      bestIndex = i;
    }
  }

  return bestIndex;
}

// ============================================================================
// 12. PRINT WAVEFORM PARAMETERS
// ============================================================================

void printWaveformParameters(float fc_kHz)
{
  float startFrequency_kHz =
      fc_kHz - FIXED_BANDWIDTH_KHZ / 2.0f;

  float endFrequency_kHz =
      fc_kHz + FIXED_BANDWIDTH_KHZ / 2.0f;

  float chirpRate_kHzPerMs =
      FIXED_BANDWIDTH_KHZ /
      (FIXED_PULSE_US / 1000.0f);

  Serial.println(F("------------------------------------------------"));
  Serial.println(F("ADAPTIVE LFM PARAMETERS"));

  Serial.print(F("Center frequency fc : "));
  Serial.print(fc_kHz, 1);
  Serial.println(F(" kHz"));

  Serial.print(F("Bandwidth B         : "));
  Serial.print(FIXED_BANDWIDTH_KHZ, 1);
  Serial.println(F(" kHz [CONSTANT]"));

  Serial.print(F("Start frequency     : "));
  Serial.print(startFrequency_kHz, 1);
  Serial.println(F(" kHz"));

  Serial.print(F("End frequency       : "));
  Serial.print(endFrequency_kHz, 1);
  Serial.println(F(" kHz"));

  Serial.print(F("Pulse duration      : "));
  Serial.print(FIXED_PULSE_US, 1);
  Serial.println(F(" us"));

  Serial.print(F("Chirp rate          : "));
  Serial.print(chirpRate_kHzPerMs, 2);
  Serial.println(F(" kHz/ms"));

  Serial.println(F("------------------------------------------------"));
}

// ============================================================================
// 13. PRINT FULL RESULT
// ============================================================================

void printResult(
    float tempVoltage,
    float depthVoltage,
    float temperature,
    float depth,
    float soundSpeed,
    int lutIndex,
    float distance)
{
  const LUTEntry &selected =
      LUT[lutIndex];

  Serial.println();
  Serial.println(F("================================================"));
  Serial.println(F("SIH26058 ADAPTIVE SONAR CONTROLLER"));
  Serial.println(F("================================================"));

  Serial.print(F("Temperature voltage : "));
  Serial.print(tempVoltage, 3);
  Serial.println(F(" V"));

  Serial.print(F("Temperature         : "));
  Serial.print(temperature, 2);
  Serial.println(F(" deg C"));

  Serial.print(F("Depth voltage       : "));
  Serial.print(depthVoltage, 3);
  Serial.println(F(" V"));

  Serial.print(F("Depth               : "));
  Serial.print(depth, 1);
  Serial.println(F(" m"));

  Serial.print(F("Salinity            : "));
  Serial.print(FIXED_SALINITY_PPT, 1);
  Serial.println(F(" ppt [FIXED]"));

  Serial.print(F("Turbidity           : "));
  Serial.print(FIXED_TURBIDITY_NTU, 1);
  Serial.println(F(" NTU [FIXED]"));

  Serial.print(F("MacKenzie c         : "));
  Serial.print(soundSpeed, 2);
  Serial.println(F(" m/s"));

  Serial.println();

  Serial.print(F("Nearest LUT row     : "));
  Serial.println(lutIndex + 1);

  Serial.print(F("LUT T               : "));
  Serial.print(selected.temperature_C, 2);
  Serial.println(F(" deg C"));

  Serial.print(F("LUT Depth           : "));
  Serial.print(selected.depth_m, 1);
  Serial.println(F(" m"));

  Serial.print(F("Normalized distance : "));
  Serial.println(distance, 6);

  Serial.print(F("Selected mode       : "));
  Serial.println(selected.mode);

  Serial.print(F("Selected fc         : "));
  Serial.print(selected.centerFrequency_kHz, 1);
  Serial.println(F(" kHz"));

  printWaveformParameters(
      selected.centerFrequency_kHz);

  // CSV record for the PC
  Serial.print(F("CSV,"));
  Serial.print(millis());
  Serial.print(',');
  Serial.print(tempVoltage, 3);
  Serial.print(',');
  Serial.print(temperature, 2);
  Serial.print(',');
  Serial.print(depthVoltage, 3);
  Serial.print(',');
  Serial.print(depth, 1);
  Serial.print(',');
  Serial.print(FIXED_SALINITY_PPT, 1);
  Serial.print(',');
  Serial.print(FIXED_TURBIDITY_NTU, 1);
  Serial.print(',');
  Serial.print(soundSpeed, 2);
  Serial.print(',');
  Serial.print(selected.mode);
  Serial.print(',');
  Serial.print(selected.centerFrequency_kHz, 1);
  Serial.print(',');
  Serial.print(FIXED_BANDWIDTH_KHZ, 1);
  Serial.print(',');
  Serial.print(FIXED_PULSE_US, 1);
  Serial.println();
}

// ============================================================================
// 14. SETUP
// ============================================================================

void setup()
{
  Serial.begin(115200);

  pinMode(TEMP_PIN, INPUT);
  pinMode(DEPTH_PIN, INPUT);

  delay(1500);

  Serial.println();
  Serial.println(F("***********************************************"));
  Serial.println(F("SIH26058 FINAL 2-POT LFM CONTROLLER"));
  Serial.println(F("***********************************************"));
  Serial.println(F("A0 = Temperature"));
  Serial.println(F("A1 = Depth"));
  Serial.println(F("Salinity  = 35 ppt [fixed]"));
  Serial.println(F("Turbidity = 100 NTU [fixed]"));
  Serial.println();
  Serial.println(F("CENTER FREQUENCY = ADAPTIVE"));
  Serial.println(F("BANDWIDTH = 50 kHz CONSTANT"));
  Serial.println(F("PULSE DURATION = 300 us CONSTANT"));
  Serial.println();
  Serial.println(F("Serial baud = 115200"));
  Serial.println(F("***********************************************"));
}

// ============================================================================
// 15. MAIN LOOP
// ============================================================================

void loop()
{
  // ------------------------------------------------------------
  // A. Read two potentiometers
  // ------------------------------------------------------------

  float tempVoltage =
      readVoltage(TEMP_PIN);

  float depthVoltage =
      readVoltage(DEPTH_PIN);

  // ------------------------------------------------------------
  // B. Convert to physical variables
  // ------------------------------------------------------------

  float temperature =
      mapVoltage(
          tempVoltage,
          TEMP_MIN_C,
          TEMP_MAX_C);

  float depth =
      mapVoltage(
          depthVoltage,
          DEPTH_MIN_M,
          DEPTH_MAX_M);

  // ------------------------------------------------------------
  // C. MacKenzie sound speed
  // ------------------------------------------------------------

  float soundSpeed =
      MackenzieSoundSpeed(
          temperature,
          FIXED_SALINITY_PPT,
          depth);

  // ------------------------------------------------------------
  // D. LUT lookup
  // ------------------------------------------------------------

  float bestDistance = 0.0f;

  int selectedIndex =
      findNearestLUT(
          temperature,
          depth,
          bestDistance);

  float newFc_kHz =
      LUT[selectedIndex].centerFrequency_kHz;

  // ------------------------------------------------------------
  // E. Report a frequency transition explicitly
  // ------------------------------------------------------------

  if (selectedIndex != previousLUTIndex)
  {
    Serial.println();
    Serial.println(F("******** CENTER-FREQUENCY UPDATE ********"));

    Serial.print(F("New mode = "));
    Serial.println(
        LUT[selectedIndex].mode);

    Serial.print(F("New fc   = "));
    Serial.print(newFc_kHz, 1);
    Serial.println(F(" kHz"));

    Serial.print(F("Bandwidth remains = "));
    Serial.print(FIXED_BANDWIDTH_KHZ, 1);
    Serial.println(F(" kHz"));

    Serial.println(
        F("******************************************"));

    previousLUTIndex =
        selectedIndex;

    previousFc_kHz =
        newFc_kHz;
  }

  // ------------------------------------------------------------
  // F. Print result
  // ------------------------------------------------------------

  printResult(
      tempVoltage,
      depthVoltage,
      temperature,
      depth,
      soundSpeed,
      selectedIndex,
      bestDistance);

  delay(1000);
}

